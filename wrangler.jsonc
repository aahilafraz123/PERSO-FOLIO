{
  // Cloudflare Worker: serves the Vite build (./dist) from the edge and runs
  // worker/index.ts only for /api/* (the contact form). `npm run deploy` builds and ships.
  "name": "aahilafraz",
  "main": "worker/index.ts",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Real paths (/work/aircast) are client routes: unknown paths get index.html.
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  // The Worker is the origin for both hostnames; Cloudflare manages their DNS and certificates.
  // www is sent to the apex by a Redirect Rule on the zone (dashboard > Rules).
  "routes": [
    { "pattern": "aahilafraz.com", "custom_domain": true },
    { "pattern": "www.aahilafraz.com", "custom_domain": true }
  ],
  "observability": { "enabled": true }
  // Secrets: wrangler secret put RESEND_API_KEY / CONTACT_TO
}
