# Cloudflare Pages headers. Vite fingerprints everything in /assets/* with a
# content hash, so those files are safe to cache forever. index.html must stay
# fresh so new deploys are picked up immediately.

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/og.png
  Cache-Control: public, max-age=86400

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
